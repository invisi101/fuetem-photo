pkgname=fuetem-photo
pkgver=0.1.1
pkgrel=1
pkgdesc='Fuetem Photo: a simple, clean photo viewer'
arch=('x86_64')
license=('MIT')
install='fuetem-photo.install'
depends=('qt6-base' 'qt6-imageformats' 'kimageformats' 'libraw' 'libheif' 'libavif'
         'libjxl' 'exiv2' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'pkgconf' 'qt6-base')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/fuetem-photo "$pkgdir/usr/bin/fuetem-photo"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/fuetem-photo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fuetem-photo.svg"
  /usr/bin/install -Dm644 "$startdir/fuetem-photo.desktop" "$pkgdir/usr/share/applications/fuetem-photo.desktop"
}
